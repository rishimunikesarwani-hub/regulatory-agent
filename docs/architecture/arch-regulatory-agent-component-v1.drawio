            <mxGeometry x="1590" y="645" width="260" height="105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="provider-note" label="Public regulatory queries only.&#10;Allow configured HTTPS endpoints.&#10;Verify authority, versions, and freshness.&#10;Provider credentials stay server-side." tooltip="Public regulatory queries only.&#10;Allow configured HTTPS endpoints.&#10;Verify authority, versions, and freshness.&#10;Provider credentials stay server-side.">
