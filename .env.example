# Copy this file to runs/private/local-demo.env.
# Use your own OpenAI API key. API credit is required for live calls.
MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Optional Langfuse Cloud project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Leave content capture disabled unless you use fictional documents only.
LANGFUSE_CAPTURE_CONTENT=
